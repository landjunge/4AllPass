FOURALLPASS_DATABASE_URL=postgresql+asyncpg://fourallpass:fourallpass@localhost:5432/fourallpass
FOURALLPASS_REDIS_URL=redis://localhost:6379/0
FOURALLPASS_SESSION_SECRET=change-me-in-production
FOURALLPASS_ENVIRONMENT=development
FOURALLPASS_DEBUG=true

# --- Access token signing (account identity only) -------------------------
# Never vault key material: this key proves *who* is calling, and cannot
# decrypt anything (see backend/app/core/security.py).
#
# Generate an Ed25519 key:
#   openssl genpkey -algorithm ed25519 -out jwt-signing-key.pem
# or an ES256 key, if a NIST curve is required:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt -out jwt-signing-key.pem
#
# Then set the PEM here (newlines as \n) or point your process manager /
# secrets store at it. Required in production: without it the API refuses to
# start, because an ephemeral key would invalidate every token on restart and
# would differ between instances.
FOURALLPASS_JWT_ALGORITHM=EdDSA
# FOURALLPASS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FOURALLPASS_JWT_ISSUER=4allpass
FOURALLPASS_JWT_AUDIENCE=4allpass-api
FOURALLPASS_ACCESS_TOKEN_TTL_SECONDS=600
FOURALLPASS_REFRESH_TOKEN_TTL_SECONDS=1209600
