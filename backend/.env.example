# Copy to backend/.env for local development.
FOURALLPASS_ENVIRONMENT=development
FOURALLPASS_DATABASE_URL=postgresql+asyncpg://4allpass:4allpass@localhost:5432/4allpass
FOURALLPASS_REDIS_URL=redis://localhost:6379/0
FOURALLPASS_CORS_ORIGINS=http://localhost:5173

# WebAuthn RP ID. Must stay stable for the life of a vault's device credentials
# and must match the origin the PWA is served from.
FOURALLPASS_WEBAUTHN_RP_ID=localhost
FOURALLPASS_WEBAUTHN_RP_NAME=4AllPass

FOURALLPASS_SESSION_TTL_SECONDS=43200
FOURALLPASS_LOGIN_ATTEMPTS_PER_MINUTE=10
