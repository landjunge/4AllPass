FOURALLPASS_DATABASE_URL=postgresql+asyncpg://fourallpass:fourallpass@localhost:5432/fourallpass
FOURALLPASS_REDIS_URL=redis://localhost:6379/0
FOURALLPASS_ENVIRONMENT=development
FOURALLPASS_DEBUG=true

# Origins allowed to send credentialed requests (CORS + the same-origin check
# on state-changing requests). A same-origin deployment needs no entry here.
FOURALLPASS_CORS_ORIGINS=["http://localhost:5173"]

# Account sessions. There is no signing secret: the cookie carries an opaque
# random token whose SHA-256 digest is the row key in `user_sessions`.
# `Secure` defaults to on outside a development environment.
FOURALLPASS_SESSION_TTL_SECONDS=1209600
FOURALLPASS_SESSION_COOKIE_NAME=fourallpass_session
FOURALLPASS_SESSION_COOKIE_SAMESITE=lax
# FOURALLPASS_SESSION_COOKIE_SECURE=true

# Argon2id parameters for *account password* hashing on the server. Unrelated
# to the vault KDF profiles in docs/test-vectors-argon2id.md, which run on the
# client and derive the Master Key.
FOURALLPASS_PASSWORD_HASH_TIME_COST=3
FOURALLPASS_PASSWORD_HASH_MEMORY_COST_KIB=65536
FOURALLPASS_PASSWORD_HASH_PARALLELISM=4
