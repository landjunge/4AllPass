FOURALLPASS_DATABASE_URL=postgresql+asyncpg://fourallpass:fourallpass@localhost:5432/fourallpass
FOURALLPASS_REDIS_URL=redis://localhost:6379/0

# Keys the HMAC that turns a session token into its storage lookup key.
# Setting ENVIRONMENT=production refuses to start on this placeholder value,
# or on anything shorter than 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FOURALLPASS_SESSION_SECRET=change-me-in-production
FOURALLPASS_SESSION_BACKEND=redis

FOURALLPASS_ENVIRONMENT=development
FOURALLPASS_DEBUG=true
FOURALLPASS_WEBAUTHN_RP_ID=localhost

# Session cookies are Secure-only when ENVIRONMENT=production; override here
# only if you terminate TLS somewhere this service cannot infer.
# FOURALLPASS_SESSION_COOKIE_SECURE=true
# FOURALLPASS_SESSION_COOKIE_SAMESITE=strict

# Enable ONLY behind a reverse proxy that overwrites X-Real-IP (as
# frontend/nginx.conf does). On a directly exposed server this would let
# callers choose their own rate-limit bucket.
# FOURALLPASS_TRUST_PROXY_CLIENT_IP=true
