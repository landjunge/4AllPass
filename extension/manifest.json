{
  "manifest_version": 3,
  "name": "4AllPass",
  "version": "0.1.0",
  "description": "Fill logins from your self-hosted 4AllPass vault. Decryption stays on this device.",
  "action": {
    "default_title": "4AllPass",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting", "contextMenus", "alarms"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the current page from the unlocked vault"
    },
    "lock-vault": {
      "description": "Lock the vault in this extension"
    }
  }
}
