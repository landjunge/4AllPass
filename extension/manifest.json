{
  "manifest_version": 3,
  "name": "4AllPass",
  "version": "0.1.0",
  "description": "Fill logins from your 4AllPass vault. Chromium, Firefox, and Safari. Decryption stays on this device.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "4AllPass",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting", "contextMenus", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8010/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8000/*",
    "http://localhost:8010/*",
    "http://localhost:8788/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@4allpass.local",
      "strict_min_version": "128.0"
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the current page from the unlocked vault"
    },
    "lock-vault": {
      "description": "Lock the vault in this extension"
    }
  }
}
