{
  "name": "4allpass",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:crypto": "npm test -w @4allpass/crypto",
    "test:crypto:heavy": "npm run test:heavy -w @4allpass/crypto",
    "test:webauthn": "npm test -w @4allpass/webauthn",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
