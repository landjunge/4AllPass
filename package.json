{
  "name": "4allpass",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend",
    "extension"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --test scripts/local-access-broker.test.mjs",
    "test:crypto": "npm test -w @4allpass/crypto",
    "test:crypto:heavy": "npm run test:heavy -w @4allpass/crypto",
    "test:webauthn": "npm test -w @4allpass/webauthn",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @4allpass/frontend",
    "test:e2e": "npm run test:e2e -w @4allpass/frontend",
    "test:e2e:live": "npm run test:e2e:live -w @4allpass/frontend",
    "build:extension": "npm run build -w @4allpass/extension",
    "build": "npm run build -w @4allpass/frontend",
    "hash:dist": "node scripts/hash-dist.mjs",
    "verify:reproducible": "node scripts/verify-reproducible-build.mjs",
    "broker": "node scripts/local-access-broker.mjs"
  }
}
