{
  "name": "4allpass",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend",
    "extension"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --test examples/n8n-github-read.test.mjs",
    "test:crypto": "npm test -w @4allpass/crypto",
    "test:crypto:heavy": "npm run test:heavy -w @4allpass/crypto",
    "test:webauthn": "npm test -w @4allpass/webauthn",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @4allpass/frontend",
    "test:e2e": "npm run test:e2e -w @4allpass/frontend",
    "test:e2e:live": "npm run test:e2e:live -w @4allpass/frontend",
    "build:extension": "npm run build -w @4allpass/extension",
    "build": "npm run build -w @4allpass/frontend",
    "hash:dist": "node scripts/hash-dist.mjs",
    "verify:reproducible": "node scripts/verify-reproducible-build.mjs",
    "broker": "npm run broker -w @4allpass/broker",
    "access:demo": "tsx examples/n8n-access-client.mjs",
    "app": "node scripts/run-local-app.mjs --open",
    "app:sidecar": "node scripts/run-local-app.mjs",
    "sidecar": "node scripts/run-sidecar.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app && bash scripts/make-dmg.sh",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:linux": "tauri build --bundles appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "tsx": "^4.20.0"
  }
}
