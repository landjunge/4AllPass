{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main 4AllPass window. UI is the loopback sidecar, not a bundled asset:// page.",
  "windows": ["main", "access-prompt"],
  "remote": {
    "urls": ["http://127.0.0.1:8788/**"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "core:event:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
